{
  "name": "doc-github-practice-skills",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test",
    "validate": "node scripts/validate-skills.mjs",
    "lint:markdown": "npm run lint:markdown:docs && npm run lint:markdown:skills && npm run lint:markdown:education",
    "lint:markdown:docs": "markdownlint-cli2 \"**/*.md\" \"#node_modules/**\" \"#skills/**\" \"#docs/superpowers/**\" \"#.superpowers/**\" \"#education/**\"",
    "lint:markdown:skills": "markdownlint-cli2 \"skills/**/*.md\" --config .markdownlint-skills.jsonc",
    "lint:markdown:education": "markdownlint-cli2 \"education/**/*.md\" --config .markdownlint-education.jsonc",
    "check": "npm run validate && npm test && npm run lint:markdown"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.23.2",
    "yaml": "^2.9.1"
  }
}
